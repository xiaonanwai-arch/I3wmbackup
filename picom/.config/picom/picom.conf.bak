# =============================================================================
# PERFORMANCE & BACKEND
# =============================================================================
backend = "glx";
vsync = true;
use-damage = true;

# =============================================================================
# CORNER RADIUS
# =============================================================================
corner-radius = 12;

# =============================================================================
# BLUR EFFECT
# =============================================================================
blur-method = "dual_kawase";
blur-strength = 5;

# =============================================================================
# SHADOWS
# =============================================================================
shadow-radius = 12;
shadow-offset-x = -15;
shadow-offset-y = -15;

# =============================================================================
# FADING
# =============================================================================
fade-in-step = 0.03;
fade-out-step = 0.03;

# =============================================================================
# WINDOW RULES (Modern Syntax)
# =============================================================================
rules = (
    {
        match = "ANY";           # Capitalized to meet standard compiler rule checks
        blur-background = true;
        shadow = true;
        fading = true;
        full-shadow = true;
    },
    {
        match = "window_type = 'dock' || window_type = 'desktop'";
        blur-background = false;
        shadow = false;
        corner-radius = 0;
    },
    {
        match = "class_g = 'Dunst'";
        opacity = 0.70;          
        blur-background = true;
        shadow = true;
        corner-radius = 12;      
    }
);

